{
  "version": 2,
  "project": {
    "name": "roca-app",
    "description": "React app with Supabase for Roca property management"
  },
  "models": {
    "default": {
      "provider": "ollama",
      "model": "qwen2.5-coder:3b"
    },
    "edit": {
      "provider": "ollama",
      "model": "qwen2.5-coder:1.5b"
    },
    "autocomplete": {
      "provider": "ollama",
      "model": "qwen2.5-coder:1.5b"
    },
    "embed": {
      "provider": "ollama",
      "model": "nomic-embed-text"
    }
  },
  "include": [
    "src/**/*",
    "*.{js,jsx,ts,tsx,json,html}",
    "vite.config.*"
  ],
  "ignore": [
    "node_modules/**",
    "dist/**",
    "**/*.min.js",
    "**/*.map"
  ]
}